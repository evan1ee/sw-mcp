{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-mcp.invalid/schemas/config/title-block/v1.json",
  "title": "Title-block mapping (spec 13.3.4)",
  "type": "object",
  "properties": {
    "config_version": { "const": "1.0" },
    "template": { "type": "string", "minLength": 1 },
    "revision_table": { "type": "boolean" },
    "fields": {
      "type": "object",
      "propertyNames": { "$ref": "../../common/v0.json#/$defs/ItemId" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "required": { "type": "boolean" }
        },
        "required": ["source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["config_version", "template", "fields"],
  "additionalProperties": false
}
