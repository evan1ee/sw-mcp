{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-mcp.invalid/schemas/mcp/contract/v0.json",
  "title": "MCP tool contract file (spec 12.4.1)",
  "type": "object",
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "$id": {
      "type": "string",
      "pattern": "^https://sw-mcp\\.invalid/schemas/mcp/[a-z]+(?:_[a-z]+)+\\.json$"
    },
    "name": { "type": "string", "pattern": "^[a-z]+(?:_[a-z]+)+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "toolset": {
      "enum": [
        "core",
        "drawing",
        "sheet_metal",
        "assembly",
        "design_intent",
        "geometry",
        "detail",
        "verification"
      ]
    },
    "phase": { "enum": ["1a", "1b", "1c", "2", "3", "4", "5", "later"] },
    "kind": { "enum": ["store", "cad-read", "cad-session", "job"] },
    "mutates": { "type": "boolean" },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "errors": {
      "type": "array",
      "items": { "$ref": "../../common/errors.json" },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "arguments": { "type": "object" },
          "response": { "$ref": "../../common/v0.json#/$defs/Envelope" }
        },
        "required": ["arguments", "response"],
        "additionalProperties": false
      }
    },
    "deprecated": { "type": "boolean" },
    "replacement": { "type": "string", "pattern": "^[a-z]+(?:_[a-z]+)+$" }
  },
  "required": [
    "$schema",
    "$id",
    "name",
    "description",
    "toolset",
    "phase",
    "kind",
    "mutates",
    "input",
    "output",
    "errors",
    "examples"
  ],
  "additionalProperties": false
}
