{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-mcp.invalid/schemas/mcp/get_execution_status.json",
  "name": "get_execution_status",
  "description": "Return a job's state, progress and outcome. Pass wait_ms (up to 20000) to wait for a state change instead of polling; a finished job returns at once.",
  "toolset": "core",
  "phase": "1a",
  "kind": "store",
  "mutates": false,
  "input": {
    "type": "object",
    "properties": {
      "execution_id": { "$ref": "../store/v0.json#/$defs/JobId" },
      "wait_ms": { "type": "integer", "minimum": 0, "maximum": 20000, "default": 0 }
    },
    "required": ["execution_id"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "execution_id": { "$ref": "../store/v0.json#/$defs/JobId" },
      "job_type": { "enum": ["plan", "produce_drawing", "check_drawing"] },
      "state": { "$ref": "../store/v0.json#/$defs/JobState" },
      "queued_position": { "$ref": "../common/v0.json#/$defs/Count" },
      "progress": {
        "type": "object",
        "properties": {
          "step": { "$ref": "../common/v0.json#/$defs/Count" },
          "of": { "$ref": "../common/v0.json#/$defs/Count" },
          "message": { "type": "string" }
        },
        "required": ["step", "of", "message"],
        "additionalProperties": false
      },
      "started_at": {
        "anyOf": [{ "$ref": "../store/v0.json#/$defs/Timestamp" }, { "type": "null" }]
      },
      "elapsed_ms": { "$ref": "../common/v0.json#/$defs/Count" },
      "retry_after_ms": { "$ref": "../common/v0.json#/$defs/Count" },
      "report_id": { "$ref": "../store/v0.json#/$defs/ReportId" },
      "part_result": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "fingerprint": { "$ref": "../common/v0.json#/$defs/ContentHash" },
          "checks": { "type": "array", "items": { "type": "object" } },
          "measured": { "type": "object" },
          "feature_ids": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "template": { "type": "string" }
        },
        "required": ["path", "fingerprint", "checks", "measured"]
      },
      "error": { "$ref": "../common/v0.json#/$defs/Error" },
      "warnings": { "type": "array", "items": { "$ref": "../store/v0.json#/$defs/JobWarning" } },
      "documents_unknown": { "type": "array", "items": { "type": "string" } }
    },
    "required": [
      "execution_id",
      "job_type",
      "state",
      "started_at",
      "warnings",
      "documents_unknown"
    ],
    "additionalProperties": false
  },
  "errors": ["IR_SCHEMA_INVALID", "EXEC_NOT_FOUND", "STORE_UNAVAILABLE"],
  "examples": [
    {
      "arguments": { "execution_id": "job_00000000000000000000000001", "wait_ms": 5000 },
      "response": {
        "ok": true,
        "data": {
          "execution_id": "job_00000000000000000000000001",
          "job_type": "check_drawing",
          "state": "EXECUTING",
          "progress": { "step": 2, "of": 4, "message": "reading the drawing back" },
          "started_at": "2026-11-04T09:00:00.000Z",
          "elapsed_ms": 2500,
          "retry_after_ms": 1000,
          "warnings": [],
          "documents_unknown": []
        },
        "error": null,
        "ids": {
          "request_id": "req_00000000000000000000000005",
          "execution_id": "job_00000000000000000000000001"
        }
      }
    },
    {
      "arguments": { "execution_id": "job_00000000000000000000000009" },
      "response": {
        "ok": false,
        "data": null,
        "error": {
          "code": "EXEC_NOT_FOUND",
          "message": "No job with this ID is known; it may have expired.",
          "retryable": "never"
        },
        "ids": {
          "request_id": "req_00000000000000000000000006",
          "execution_id": "job_00000000000000000000000009"
        }
      }
    }
  ]
}
