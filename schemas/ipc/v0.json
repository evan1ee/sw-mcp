{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-mcp.invalid/schemas/ipc/v0.json",
  "title": "IPC messages between the core and the add-in (spec 8.7)",
  "x-protocol-version": "0.1",
  "anyOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    },
    {
      "$ref": "#/$defs/Notification"
    }
  ],
  "$defs": {
    "Meta": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        }
      }
    },
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "../common/v0.json#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {},
        "error": {
          "$ref": "#/$defs/RpcError"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "../common/v0.json#/$defs/Error"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Notification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ]
    },
    "HelloParams": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "token",
        "protocol"
      ]
    },
    "SolidWorksInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "service_pack": {
          "type": "string"
        },
        "ui_language": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "service_pack",
        "ui_language"
      ]
    },
    "OperationInfo": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string"
        },
        "schema_version": {
          "$ref": "../common/v0.json#/$defs/SchemaVersion"
        }
      },
      "required": [
        "op",
        "schema_version"
      ]
    },
    "HelloResult": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string"
        },
        "addin_version": {
          "type": "string"
        },
        "solidworks": {
          "$ref": "#/$defs/SolidWorksInfo"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationInfo"
          }
        },
        "licensed_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "protocol",
        "addin_version",
        "solidworks",
        "capabilities",
        "operations",
        "licensed_modules",
        "warnings"
      ]
    },
    "PingParams": {
      "type": "object",
      "properties": {
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "PingResult": {
      "type": "object",
      "properties": {
        "pong": {
          "const": true
        }
      },
      "required": [
        "pong"
      ]
    },
    "CompletedOperationsParams": {
      "type": "object",
      "properties": {
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "CompletedOperationsResult": {
      "type": "object",
      "properties": {
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "operation_ids"
      ]
    },
    "SnapshotParams": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "document"
      ]
    },
    "SnapshotResult": {
      "$ref": "../drawing-geometry-snapshot/v0.json"
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "op"
      ]
    },
    "OperationGroup": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "minItems": 1
        }
      },
      "required": [
        "document",
        "operations"
      ]
    },
    "OpsApplyParams": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationGroup"
          },
          "minItems": 1
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "groups"
      ]
    },
    "OperationOutcome": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "result": {},
        "error": {
          "$ref": "../common/v0.json#/$defs/Error"
        }
      },
      "required": [
        "operation_id"
      ]
    },
    "OpsApplyResult": {
      "type": "object",
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationOutcome"
          }
        }
      },
      "required": [
        "outcomes"
      ]
    },
    "JobCancelParams": {
      "type": "object",
      "properties": {
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "JobCancelResult": {
      "type": "object",
      "properties": {
        "cancelled": {
          "type": "boolean"
        }
      },
      "required": [
        "cancelled"
      ]
    },
    "JobProgressParams": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "done": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "total": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "DocumentEventParams": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "event": {
          "enum": [
            "regen",
            "save",
            "close",
            "active_changed"
          ]
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "document",
        "event"
      ]
    },
    "UiBlockedParams": {
      "type": "object",
      "properties": {
        "waited_ms": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "_meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "waited_ms"
      ]
    },
    "ResponseChunkParams": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "index": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "count": {
          "$ref": "../common/v0.json#/$defs/Count"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "index",
        "count",
        "data"
      ]
    }
  }
}
